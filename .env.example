ANTHROPIC_API_KEY=your_key_here

# Local pgvector instance for the Layer 2 dictionary index.
# Port 5433, not 5432 — keep it off the default so a stray client cannot
# reach a different Postgres by accident.
PG_HOST=localhost
PG_PORT=5433
PG_DB=honest_mistake
PG_USER=hm
PG_PASSWORD=replace-with-a-locally-generated-password
