# Data (large raw + regenerable processed files — keep on disk, out of git)
data/raw/
data/processed/

# Model artifacts (except the small best-params records, which carry the
# tuned settings and the canary's before/after AUCs that answer_key reads)
outputs/models/*
!outputs/models/best_params.json
!outputs/models/best_params_canary.json

# Agent caches (regenerable). Only the per-row SHAP matrices are excluded;
# they are 30 MB each. Everything else in these directories is a small
# evidence file and is tracked by default. Written this way round on
# purpose: the previous form listed each tracked file by name, and three
# times a new artefact was silently left untracked because nobody
# remembered to add a line for it.
outputs/agent_cache/*.parquet
outputs/agent_cache_canary/*.parquet

# Phase 5's long-format SHAP artefact: rebuilt from shap_values.parquet by
# scripts/build_phase5_artefact.py and identified by the hash recorded in
# PREREGISTRATION_PHASE5.md, so it stays out of git like its source.
outputs/layer3/phase5/*.parquet

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environment
.venv/

# Secrets (.env.example is tracked)
.env

# macOS
.DS_Store

# Local editor and preview config. launch.json holds the static preview
# server for docs/, which is a local convenience and not part of the site.
.claude/

# Generated verification cases. The harnesses in verify/ are tracked; these
# three are rebuilt by the scripts/verify_js_*.py generators and are derived
# data — 750 KB, 120 KB and 66 KB.
verify/cases.json
verify/scoring_cases.json
verify/parse_cases.json
